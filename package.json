{
  "name": "zyrax-forum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build_dashboard_worker.cjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create cloudforum-db",
    "d1:init:local": "wrangler d1 execute cloudforum-db --local --file=./schema/d1.sql",
    "d1:init:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/d1.sql",
    "d1:migrate:auth-plus:local": "wrangler d1 execute cloudforum-db --local --file=./schema/migration_auth_plus.sql",
    "d1:migrate:auth-plus:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/migration_auth_plus.sql",
    "seed:admin:local": "wrangler d1 execute cloudforum-db --local --file=./schema/seed_admin.sql",
    "seed:admin:remote": "wrangler d1 execute cloudforum-db --remote --file=./schema/seed_admin.sql"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
